# === LLM Configuration ===
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# === Database ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/risetbot

# === Server Ports ===
PORT=8000
PYTHON_SERVICE_PORT=9000
PYTHON_SERVICE_URL=http://localhost:9000
FRONTEND_PORT=3000

# === PageIndex (Self-hosted) ===
# Used by litellm inside PageIndex for tree generation
CHATGPT_API_KEY=sk-your-api-key-here
TREE_INDEX_DIR=./tree_indexes

# === Langfuse (Observability) ===
LANGFUSE_SECRET_KEY=your-langfuse-secret
LANGFUSE_PUBLIC_KEY=your-langfuse-public
LANGFUSE_HOST=http://localhost:3001

# === File Storage ===
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
TEMPLATE_DIR=./templates
